{
    "name": "voice-channels-p2p",
    "version": "1.1.1",
    "description": "Self-hosted persistent voice channels over P2P WebRTC (based on MiroTalk P2P)",
    "main": "server.js",
    "scripts": {
        "prestart": "test -f app/src/config.js || cp app/src/config.template.js app/src/config.js",
        "start": "node app/src/server.js",
        "dev": "node --watch app/src/server.js",
        "test": "mocha tests/*.js",
        "lint": "npx prettier --write .",
        "docker:build": "docker build --tag voice-channels:latest .",
        "docker:rmi": "docker images |grep '<none>' |awk '{print $3}' |xargs docker rmi",
        "docker:push": "docker push voice-channels:latest",
        "docker:pull": "docker pull voice-channels:latest",
        "docker:rmc": "docker container rm voice-channels --force",
        "docker:run": "docker run -d -p 3000:3000 --name voice-channels voice-channels:latest",
        "docker:rune": "docker run -d -p 3000:3000 -v .env:/src/.env:ro --name voice-channels voice-channels:latest",
        "docker:run-vm": "docker run -d -p 3000:3000 -v .env:/src/.env:ro -v ./app/:/src/app/:ro -v ./public/:/src/public/:ro --name voice-channels voice-channels:latest",
        "docker:start": "docker start voice-channels",
        "docker:stop": "docker stop voice-channels"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/junncey/voice-channels-p2p.git"
    },
    "keywords": [
        "webrtc",
        "socket.io",
        "p2p",
        "nodejs",
        "audio",
        "voice",
        "chat",
        "self-hosted"
    ],
    "author": "Miroslav Pejic <https://github.com/miroslavpejic85> (MiroTalk P2P), B1at (voice channels fork)",
    "contributors": [
        {
            "name": "Miroslav Pejic",
            "url": "https://github.com/miroslavpejic85"
        }
    ],
    "license": "AGPL-3.0",
    "homepage": "https://github.com/junncey/voice-channels-p2p",
    "dependencies": {
        "colors": "^1.4.0",
        "compression": "^1.8.2",
        "cors": "^2.8.6",
        "dompurify": "^3.4.17",
        "dotenv": "^18.0.8",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "he": "^2.0.0",
        "helmet": "^8.3.0",
        "httpolyglot": "0.1.2",
        "jsdom": "^30.1.3",
        "jsonwebtoken": "^9.0.3",
        "socket.io": "^4.8.4"
    },
    "devDependencies": {
        "mocha": "^12.0.3",
        "prettier": "3.9.10",
        "should": "^13.2.3"
    }
}
